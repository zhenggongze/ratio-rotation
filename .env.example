# 比值轮动系统环境变量配置
# 复制此文件为 .env 并填入实际值

# PushDeer 推送密钥（从系统环境变量读取，此处仅作备用说明）
# PUSHDEER_KEY=PDUxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 数据源配置
DATA_SOURCE_PRIMARY=tencent
DATA_SOURCE_BACKUP=csindex

# 资金参数
INIT_CAPITAL=1600000
TIER_AMOUNT=80000

# 策略区域端点
BUY_ZONE_TOP=0.332
SELL_ZONE_BOTTOM=0.578
SELL_ZONE_TOP=0.710

# 校准窗口（年）
CALIB_WINDOW_YEARS=5

# 推送时间
PUSH_TIME=15:30

# 备份目录
BACKUP_DIR=backup

# 阿里云 OSS 部署配置（部署时通过环境变量注入，不硬编码）
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_REGION=cn-hangzhou
# CDN_DOMAIN=
